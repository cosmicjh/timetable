{
  "name": "school-timetable-workers",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs && node scripts/wrangler.mjs dev --local --ip 127.0.0.1 --port 8787",
    "dev:studyroom": "node scripts/studyroom-preview.mjs",
    "deploy": "node scripts/check-deploy.mjs && wrangler deploy",
    "setup:local": "node scripts/setup.mjs",
    "setup:production": "node scripts/setup.mjs --production",
    "db:migrate:local": "node scripts/wrangler.mjs d1 migrations apply DB --local && node scripts/wrangler.mjs d1 migrations apply COURSE_DB --local",
    "db:migrate:remote": "node scripts/check-deploy.mjs && wrangler d1 migrations apply DB --remote",
    "test": "node --test --test-concurrency=1 tests/*.test.mjs",
    "test:browser": "node tests/browser.mjs && node tests/solver-browser.mjs && node tests/browser-solver.mjs",
    "test:section-assignment": "node tests/section-assignment-browser.mjs",
    "test:worker": "node tests/wrangler.mjs",
    "test:all": "pnpm test && pnpm test:browser && pnpm test:section-assignment && pnpm test:pages-browser && pnpm test:worker && pnpm test:teacher-tools && pnpm test:allocation && pnpm test:studyroom-browser",
    "test:studyroom-browser": "node tests/studyroom-browser.mjs",
    "test:allocation": "node tests/allocation-browser.mjs",
    "benchmark": "node scripts/benchmark.mjs",
    "benchmark:browser": "node scripts/benchmark-browser.mjs",
    "compare:backups": "node scripts/compare-backups.mjs",
    "test:remote": "node scripts/verify-remote.mjs",
    "build:pages": "node scripts/build-pages.mjs",
    "test:pages-browser": "node tests/pages-browser.mjs",
    "test:teacher-tools": "node tests/teacher-tools-browser.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "miniflare": "^4.20260730.0",
    "or-tools-wasm": "1.0.0",
    "playwright": "^1.64.1",
    "wrangler": "4.156.0"
  }
}
